rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdminEmail() {
      return signedIn() && request.auth.token.email != null && (
        request.auth.token.email.toLowerCase() == 'rufaijohnny@gmail.com' ||
        request.auth.token.email.toLowerCase() == 'johnrufai242@gmail.com'
      );
    }

    function hasUser() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function member() {
      return signedIn() && (!hasUser() || me().status != 'inactive');
    }

    function admin() {
      return signedIn() && (
        isAdminEmail() ||
        (hasUser() && me().role == 'admin')
      );
    }

    function self(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Default catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection
    match /users/{userId} {
      allow get, list: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if admin() || self(userId);
      allow delete: if admin();

      match /conversations/{id} {
        allow read, write: if self(userId) || admin();
      }
      match /memories/{id} {
        allow read, write: if self(userId) || admin();
      }
      match /private/{document=**} {
        allow read, write: if self(userId) || admin();
      }
      match /dailyReports/{id} {
        allow read, write: if self(userId) || admin();
      }
    }

    match /invitations/{id} {
      allow read, write: if signedIn();
    }

    match /connections/{id} {
      allow read, write: if signedIn();
    }

    match /shares/{id} {
      allow read, write: if signedIn();
    }

    match /notifications/{id} {
      allow read, write: if signedIn();
    }

    match /activityLogs/{id} {
      allow read, create: if signedIn();
      allow update, delete: if admin();
    }

    match /tasks/{id} {
      allow read, write: if signedIn();
    }

    match /documents/{id} {
      allow read, write: if signedIn();
    }

    match /projects/{id} {
      allow read, write: if signedIn();
    }

    match /clients/{id} {
      allow read, write: if signedIn();
    }

    match /meetings/{id} {
      allow read, write: if signedIn();
    }

    match /followUps/{id} {
      allow read, write: if signedIn();
    }

    match /knowledge/{id} {
      allow read, write: if signedIn();
    }

    match /reports/{id} {
      allow read, write: if signedIn();
    }

    match /inbox/{id} {
      allow read, write: if signedIn();
    }

    match /payments/{id} {
      allow read, write: if signedIn();
    }

    match /resourceShares/{id} {
      allow read, write: if signedIn();
    }

    match /sharedRecords/{id} {
      allow read, write: if signedIn();
    }

    match /documents/{documentId}/versions/{versionId} {
      allow read, write: if signedIn();
    }

    match /recurringMeetingTemplates/{id} {
      allow read, write: if signedIn();
    }

    match /recurringTaskTemplates/{id} {
      allow read, write: if signedIn();
    }

    match /conversations/{id} {
      allow read, write: if signedIn();
    }

    match /memories/{id} {
      allow read, write: if signedIn();
    }
  }
}
